# ─── AskPDF Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Stores document metadata, conversations, and messages.
# Free M0 Atlas works fine — vectors live in Qdrant, not here.
# Local : mongodb://localhost:27017/askpdf
# Atlas : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/askpdf
MONGO_URI=mongodb://localhost:27017/askpdf

# If your router can't resolve mongodb+srv:// addresses (the app only connects
# after opening Compass), the server falls back to these public DNS servers.
# DNS_FALLBACK_SERVERS=8.8.8.8,1.1.1.1

# ── Vector store ──────────────────────────────────────────────────────────────
# auto    — use Qdrant if reachable at startup, otherwise MongoDB (default)
# qdrant  — Qdrant only; refuse to start if it is unreachable
# mongodb — keep embeddings in MongoDB; Qdrant not needed at all
VECTOR_STORE=auto

# ── Qdrant (optional dedicated vector search) ────────────────────────────────
# Some networks/ISPs block *.cloud.qdrant.io (TLS "connection reset").
# In that case use a local Docker Qdrant, another network, or VECTOR_STORE=mongodb.
#
# Option A — Local Docker (free, zero config)
#   docker run -p 6333:6333 qdrant/qdrant
#   QDRANT_URL=http://localhost:6333
#   leave QDRANT_API_KEY blank
#
# Option B — Qdrant Cloud (free 1 GB cluster, no credit card)
#   Sign up at https://cloud.qdrant.io
#   Create a free cluster → copy the cluster URL and API key
#   QDRANT_URL=https://xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
#   QDRANT_API_KEY=your_qdrant_cloud_api_key
#
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                     ← only needed for Qdrant Cloud

# Name of the Qdrant collection. Created automatically on first startup.
QDRANT_COLLECTION=askpdf_chunks

# ── Redis (OPTIONAL) ──────────────────────────────────────────────────────────
# Not used for vector search. Leave commented out if you don't need it.
# REDIS_URL=redis://localhost:6379

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM used for answer synthesis and document briefs
GROQ_MODEL=qwen/qwen3.8-27b

# Optional faster model for research-engine helper steps
# (query rewriting, planning, follow-up suggestions, titles).
# Defaults to GROQ_MODEL when unset.
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Embeddings ────────────────────────────────────────────────────────────────
# Embeddings run locally via @xenova/transformers (Xenova/all-MiniLM-L6-v2).
# EMBED_DIM MUST match that model AND the Qdrant collection vector size.
EMBED_DIM=384

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── RAG tunables ──────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Max answer length in tokens (quick / deep research). On Groq's free tier,
# output tokens per minute are capped — lower these if you see 429 errors.
ANSWER_MAX_TOKENS=1024
DEEP_ANSWER_MAX_TOKENS=2048

# ── CORS / Security ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
RATE_LIMIT_MAX=100
